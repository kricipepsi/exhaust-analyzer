    {
      "rule_id": "MW-003",
      "fault_family": "mechanical_wear",
      "description": "Coolant in combustion / head gasket breach: coolant enters combustion chamber through failed head gasket, quenching combustion. Produces COOLANT_LEAK_INTERNAL chemistry \u2014 elevated HC + elevated O2 + depressed CO2 simultaneously. OBD: ect_c > 95.0 degC as SUGGESTIVE (coolant loss concentrates heat in remaining coolant, raising sensor reading). v1 ERR-MW-002 expanded (v1 had ect_c > 90.0 only; v2 tightens to 95.0 and adds chemistry-primary architecture)",
      "chemistry_evidence": [
        {
          "state": "COOLANT_LEAK_INTERNAL",
          "tier": "GATING",
          "wiki_ref": "GAS_VOCABULARY \u00a73"
        }
