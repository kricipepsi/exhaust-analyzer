    {
      "rule_id": "SF-001",
      "fault_family": "sensor_fault",
      "description": "Upstream O2 sensor slow/lazy response \u2014 biased high: gas analyser confirms stoichiometric chemistry (normal operation) while OBD lambda perception is biased high (sensor reads falsely lean, ECU over-fuels). Sensor still switches but cross-counts are sluggish. No circuit DTC \u2014 the sensor works, just too slowly. v1 ERR-SF-001 perception_flag path, v2 evidence-tier form",
      "chemistry_evidence": [
        {
          "state": "O2_SENSOR_BIASED_HIGH",
          "tier": "DEFINITIVE",
          "wiki_ref": "GAS_VOCABULARY \u00a73"
        }
      ],
      "obd_evidence": [
        {
          "pid": "lambda_perception_delta",
          "operator": "gt",
          "value": 0.03,
          "tier": "DEFINITIVE",
          "units": "lambda",
          "wiki_ref": "T-FX-6 \u00a7PerceptionContradictionResult"
        },
        {
          "pid": "o2_voltage",
          "operator": "ge",
          "value": 0.55,
          "tier": "DEFINITIVE",
          "units": "V",
          "wiki_ref": "OBD_VOCABULARY \u00a712.1"
        }
      ],
      "base_weight": 0.85,
      "competition_group": "sensor_fault",
      "perception_flag": "O2_SENSOR_BIASED_HIGH",
      "precondition": "o2_voltage sourced from freeze_frame o2_voltage_b1s1 (SAE J1979 PID 0114); not in OBDLivePayload",
      "passes_cases": [
