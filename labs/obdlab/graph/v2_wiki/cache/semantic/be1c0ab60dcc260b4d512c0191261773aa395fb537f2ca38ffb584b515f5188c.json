{"nodes": [{"id": "entity_control_module_voltage_v", "label": "control_module_voltage_v", "file_type": "code", "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scalar OBDLab emission of VPWR (PID 0x42), no verdict. Field + consumer ship together as proposal EP-OBD-IN-04."}, {"id": "entity_vpwr", "label": "VPWR", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supply voltage at PCM pins; every sensor reference is built on a clean DC rail, so a low/high/ripply rail shifts stoichiometric points and sensor references before any air/fuel sensor is at fault. Must be ruled out first or the engine blames the wrong subsystem. Healthy ~13.5-14.7 V running; <12.0 V charging/ground fault; >15.0 V over-charging/AC ripple."}, {"id": "entity_delta_vpwr", "label": "DELTA_VPWR", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low-to-high idle sweep: DeltaVPWR < -1.0 V under revs = alternator/regulator diode fault; > +2.5 V (system > 15.5 V) = over-charging, ripple into sensor references -> EP-FA-05. AC ripple is inferred downstream from DeltaVPWR - VPWR is a scalar read, not a waveform."}, {"id": "entity_p0606", "label": "P0606", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "entity_comlab_electrical_health_precheck", "label": "COMLab electrical-health pre-check", "file_type": "code", "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed perception_contradiction.py pre-check (T-COMV2-VPWR-GATE-1): down-weights/suppresses sensor-fault candidates when the PCM rail is out of band so a charging fault is not mis-routed as an O2/MAF fault."}, {"id": "entity_ep_fa_05", "label": "EP-FA-05", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alternator-AC-ripple fault node; charging-side faults route here."}, {"id": "entity_obdlab", "label": "OBDLab", "file_type": "code", "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "entity_obdlab", "target": "entity_control_module_voltage_v", "relation": "emits", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "weight": 1.0}, {"source": "entity_control_module_voltage_v", "target": "entity_comlab_electrical_health_precheck", "relation": "consumed_by", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "weight": 1.0}, {"source": "entity_vpwr", "target": "entity_perception_contradiction", "relation": "suppresses_sensor_fault_routing", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "research/chunks/ecu-diagnosis/09_control-module-voltage.md", "source_location": null, "weight": 1.0}, {"source": "entity_delta_vpwr", "target": "entity_ep_fa_05", "relation": "routes_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/ecu-diagnosis/09_control-module-volta