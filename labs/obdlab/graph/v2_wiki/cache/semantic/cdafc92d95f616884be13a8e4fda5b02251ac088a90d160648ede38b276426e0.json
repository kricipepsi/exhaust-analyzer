{"nodes": [{"id": "entity_vsum", "label": "VSUM", "file_type": "rationale", "source_file": "research/chunks/delta-relations/08_vsum-sample-validity-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "vsum = HC+CO+CO2+O2+NOx (% volume). Valid 14.0-18.0%; <14% severe dilution (probe/tailpipe leak); >18% near-ambient/exhaust leak bypassing cat. Diluted samples produce false-lean lambda and corrupt every downstream delta, so the gate must run before any Delta-gas or Brettschneider-lambda. The vsum display equation was image-stripped in Vol7 export; thresholds survive in prose."}, {"id": "entity_gas_sample_valid", "label": "GAS_SAMPLE_VALID", "file_type": "code", "source_file": "research/chunks/delta-relations/08_vsum-sample-validity-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-frame validity flag GASLab marks alongside vsum; field + consumer (COMLab delta engine skip) ship together per v2 forward-progress rule. A frame failing vsum at idle but passing at 2500 RPM is itself a sampling-integrity signature, not an engine fault."}, {"id": "entity_dilution_fail", "label": "DILUTION_FAIL", "file_type": "rationale", "source_file": "research/chunks/delta-relations/08_vsum-sample-validity-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CO + CO2 <= 6.0%: too much ambient air for a reliable profile."}], "edges": [{"source": "entity_gaslab", "target": "entity_gas_sample_valid", "relation": "emits", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/delta-relations/08_vsum-sample-validity-gate.md", "source_location": null, "weight": 1.0}, {"source": "entity_gaslab", "target": "entity_vsum", "relation": "emits", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/delta-relations/08_vs