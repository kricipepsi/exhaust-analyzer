{"nodes": [{"id": "entity_delta_trim", "label": "DELTA_TRIM", "file_type": "rationale", "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "source_url": "https://gemini.google.com/share/23ff406a7345", "captured_at": null, "author": null, "contributor": null, "rationale": "Primary diagnostic value of fuel trims (1990-2010 petrol) is the difference between trims at two engine speeds, not the value at one speed. Discriminating axis: whether trim improves or worsens under load. No live consumer yet; stays PENDING per SWEEP_MANIFEST FU-2 signal/noise rule."}, {"id": "entity_total_trim", "label": "TOTAL_TRIM", "file_type": "rationale", "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "source_url": "https://gemini.google.com/share/23ff406a7345", "captured_at": null, "author": null, "contributor": null, "rationale": "The engine evaluates total trim (STFT+LTFT), not STFT or LTFT in isolation, because LTFT can fully absorb a settled bias (e.g. vacuum leak as STFT 0% with LTFT +24%) and either value alone masks it."}, {"id": "entity_stft", "label": "STFT", "file_type": "rationale", "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "entity_ltft", "label": "LTFT", "file_type": "rationale", "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "entity_low_idle", "label": "LOW_IDLE", "file_type": "rationale", "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "600-800 RPM, zero external load (FuelTrimW); EcuSignatures uses 700-800 RPM. Maps to live RpmStateBucket.STABILIZED_IDLE (650-900)."}, {"id": "entity_stress_idle", "label": "STRESS_IDLE", "file_type": "rationale", "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steady-state throttle hold 3500-4500 RPM, park/neutral (FuelTrimW + EcuSignatures). Band conflict: Vol7 gas-side uses 2500 RPM; reconcile in FU-2 / O2-FU-3 before fusing OBD and gas sides."}, {"id": "entity_comlab_delta_calculation_script", "label": "COMLab delta-calculation script", "file_type": "code", "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed consumer (SWEEP_MANIFEST FU-2) for all DeltaTrim chunks. Per signal/noise rule every delta field stays PENDING until this script reads it in a live code path. Must branch on air-metering architecture (MAF vs speed-density, forced induction) before applying profiles 02-05."}], "edges": [{"source": "entity_total_trim", "target": "entity_stft", "relation": "equals", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "weight": 1.0}, {"source": "entity_total_trim", "target": "entity_ltft", "relation": "equals", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "weight": 1.0}, {"source": "entity_delta_trim", "target": "entity_total_trim", "relation": "equals", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/delta-relations/01_delta-method-and-formula.md", "source_location": null, "weight": 1.0}, {"source": "entity_vacuum_leak", "target": "entity_delta_trim", "relation": "produces_negative", "confidence": "EXTRA