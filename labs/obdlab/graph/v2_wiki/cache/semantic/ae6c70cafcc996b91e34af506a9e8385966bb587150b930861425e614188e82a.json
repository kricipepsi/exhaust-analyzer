{"nodes": [{"id": "entity_delta_gas", "label": "DELTA_GAS", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diagnostic value of a 5-gas reading is the change from curb idle to stabilised 2500 RPM. Vacuum-dependent faults attenuate at 2500 RPM; speed-dependent mechanical faults intensify. Only the sign of Delta-gas across the speed step separates faults reading identically at idle (e.g. GAS-WVS improves vs GAS-WPR worsens). GASLab owns per-state frames (stateless); COMLab owns cross-state delta math."}, {"id": "entity_gas_vac_001", "label": "GAS-VAC-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vacuum-line FPR rupture: rich attenuates at 2500 RPM - lower vacuum cuts leak flow + dilution."}, {"id": "entity_gas_lean_001", "label": "GAS-LEAN-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intake vacuum leak: lean attenuates at 2500 RPM - leak negligible vs metered air."}, {"id": "entity_gas_eal_001", "label": "GAS-EAL-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-cat exhaust leak: positive exhaust pressure at 2500 RPM blocks air ingress; false-rich trim corrects."}, {"id": "entity_gas_wpr_001", "label": "GAS-WPR-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worn piston rings: oil burn intensifies at 2500 RPM (blow-by + ring speed)."}, {"id": "entity_gas_wvs_001", "label": "GAS-WVS-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worn valve seals: oil induction clears at 2500 RPM - vacuum drop stops guide pull."}, {"id": "entity_gas_fc_001", "label": "GAS-FC-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flat camshaft lobe: restricted lift = high-speed breathing misfire at 2500 RPM."}, {"id": "entity_gas_esc_001", "label": "GAS-ESC-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EGR stuck closed: no dilution -> NOx runaway past 1370 C (1500 -> 2800 ppm)."}, {"id": "entity_gas_eso_001", "label": "GAS-ESO-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EGR stuck open: high intake volume at 2500 RPM dilutes stuck EGR; stabilises."}, {"id": "entity_gas_evap_001", "label": "GAS-EVAP-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saturated EVAP: purge opens at 2500 RPM -> raw-vapour spike (worsens)."}, {"id": "entity_gas_cnl_001", "label": "GAS-CNL-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cold cat (no light-off): thermal light-off at 2500 RPM - healthy cat recovers."}, {"id": "entity_gas_cov_001", "label": "GAS-COV-001", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cat overload/blow-through: residence time too short - gases blow through at both speeds."}, {"id": "entity_gaslab", "label": "GASLab", "file_type": "code", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owning lab for the per-state 5-gas frame; stays stateless per isolation contract - cross-state delta math belongs to COMLab."}, {"id": "entity_comlab_delta_engine", "label": "COMLab delta engine", "file_type": "code", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same proposed FU-2 consumer that reads DeltaTrim; gas-side name used in Vol7 chunks. Must skip delta computation on frames failing the vsum validity gate."}, {"id": "entity_worn_rings", "label": "WORN_RINGS", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matrix-2speed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "entity_worn_valve_seals", "label": "WORN_VALVE_SEALS", "file_type": "rationale", "source_file": "research/chunks/delta-relations/07_gas-transition-matri