{"nodes": [{"id": "entity_injector_driver_open", "label": "INJECTOR_DRIVER_OPEN", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/03_injector-driver-open-and-short.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open-circuit low-side driver: one cylinder dead on B1 pumps pure air -> upstream O2 pegs lean, STFT/LTFT B1 pinned +25%, B2 balanced, held across both idle bands. Surviving B1 cylinders run rich from global max enrichment (deceptive CO alongside high O2)."}, {"id": "entity_injector_driver_short", "label": "INJECTOR_DRIVER_SHORT", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/03_injector-driver-open-and-short.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drain-source fuse -> injector sprays constantly -> flooded cylinder, rich misfire; B1 trims pinned -25%, lambda_chem 0.78-0.81. Overlaps detect_compensated_rich's railed-negative-trim pattern but its lambda_chem is outside that detector's stoich window [0.95,1.05], so the live detector would not fire - and would mis-verdict 'fuel leak' if it did. Bank asymmetry is the signal, unread today."}, {"id": "entity_err_ef_007", "label": "ERR-EF-007", "file_type": "code", "source_file": "research/chunks/ecu-diagnosis/03_injector-driver-open-and-short.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "entity_detect_compensated_rich", "label": "detect_compensated_rich", "file_type": "code", "source_file": "research/chunks/ecu-diagnosis/03_injector-driver-open-and-short.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "entity_injector_driver_open", "target": "entity_ltft", "relation": "pins", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/ecu-