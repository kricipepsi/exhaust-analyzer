{"nodes": [{"id": "entity_vacuum_leak", "label": "VACUUM_LEAK", "file_type": "rationale", "source_file": "research/chunks/delta-relations/02_profile-vacuum-leak.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High manifold vacuum at low idle (18-22 in-Hg) pulls unmetered air downstream of MAF; leak is large fraction of low idle airflow (lean, +15..+25% trim) but negligible at 3500-4500 RPM, so trims normalise and DeltaTrim goes <= -10%. Signature only valid on MAF closed-loop architecture."}, {"id": "entity_maf_closed_loop", "label": "MAF_CLOSED_LOOP", "file_type": "rationale", "source_file": "research/chunks/delta-relations/02_profile-vacuum-leak.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "entity_speed_density", "label": "SPEED_DENSITY", "file_type": "rationale", "source_file": "research/chunks/delta-relations/02_profile-vacuum-leak.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Speed-Density paradox: on a MAP-only engine leak air raises MAP, the ECU references a higher VE cell and adds matching fuel, IAC closes to hold RPM -> trims stay near 0%, DeltaTrim ~ 0 for a real leak. Leak shows instead as reduced IAC counts, elevated idle MAP (~45 vs ~30 kPa), idle flare."}], "edges": [{"source": "entity_vacuum_leak", "target": "entity_ltft", "relation": "raises", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/chunks/delta-relations/02_profile-vacuum-leak.md", "source_location": null, "weight": 1.0}, {"source": "entity_vacuum_leak", "target": "entity_low_idle", "relation": "manifests_at", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "research/chunks/delta-relations/02_profile-vacuum-leak.md", "source_location": null, "weight": 1.0}, {"source": "entity_vacuum_leak", "target": "entity_delta_trim", "relati