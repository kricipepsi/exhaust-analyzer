{"nodes": [{"id": "entity_sensor_ground_trace_open", "label": "SENSOR_GROUND_TRACE_OPEN", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/05_sensor-ground-trace-open.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vaporised internal reference-ground trace floats sensor ground to 1.5-4.5 V, corrupting every ratiometric sensor at once: ECT/IAT locked -40 C, TPS 100%, LOAD_PCT 80-100% on a parked warmed engine, frozen trims, severe rich (lambda_chem ~0.72). All-banks symmetric locked-sensor pattern is the strongest internal-ECU tell vs single external sensor fault. Blocking gap: TPS and IAT have no OBDLivePayload fields (ECU-FU-3)."}, {"id": "entity_ect", "label": "ECT", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/05_sensor-ground-trace-open.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps to live coolant_temp_c (range -40..140)."}, {"id": "entity_iat", "label": "IAT", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/05_sensor-ground-trace-open.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No live OBDLivePayload field; companion proposal ECU-FU-3 - field only added if the proposed checker names it as consumer."}, {"id": "entity_tps", "label": "TPS", "file_type": "rationale", "source_file": "research/chunks/ecu-diagnosis/05_sensor-ground-trace-open.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No live OBDLivePayload field; companion proposal ECU-FU-3 - field only added if the proposed checker names it as consumer."}, {"id": "entity_err_ef_006", "label": "ERR-EF-006", "file_type": "code", "source_file": "research/chunks/ecu-diagnosis/05_sensor-ground-trace-open.md", "source_location": null, "source_