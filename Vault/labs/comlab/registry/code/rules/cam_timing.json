  "rules": [
    {
      "rule_id": "CT-001",
      "fault_family": "cam_timing",
      "description": "Mechanical base timing error (non-VVT): physical camshaft timing is incorrect due to belt/chain misalignment, independent of VVT system. Produces CAM_TIMING_RETARDED_MAF chemistry \u2014 elevated HC + CO with depressed CO2. No cam sensor DTC expected on non-VVT engines. v1 ERR-CT-001 reactivated, map_kpa constraint removed (no MAP data in curated corpus for any cam_timing case). This is the only cam_timing rule without a VVT precondition \u2014 closes the v1 gap where 4 of 5 rules required vvt_equipped",
      "chemistry_evidence": [
        {
          "state": "CAM_TIMING_RETARDED_MAF",
          "tier": "GATING",
          "wiki_ref": "GAS_VOCABULARY \u00a73"
        }
      ],
      "obd_evidence": [],
      "dtc_evidence": [],
      "base_weight": 0.8,
      "competition_group": "cam_timing",
      "precondition": "vvt_equipped: false OR vvt_equipped: unknown",
      "passes_cases": [
        "MECH-004"
      ],
      "source_wiki_refs": [
        "GAS_VOCABULARY \u00a73"
      ]
    },
    {
      "rule_id": "CT-002",
      "fault_family": "cam_timing",
      "description": "VVT phaser malfunction \u2014 retard / lag pattern: VVT phaser is sluggish, stuck retarded, or lagging under load. Produces VVT_FAILURE chemistry \u2014 elevated HC, depressed CO2, low NOx (<80 ppm). The low NOx differentiates cam_timing from lean_condition (NOx >800 ppm). Typically accompanied by P0011 (cam over-advanced) or P0012 (cam over-retarded). TIMING_RETARDED chemistry accepted as SUGGESTIVE evidence \u2014 closes the ~3-case Tier B gap for cam_timing. OBD evidence: fuel trims mildly elevated (stft > 2.0) as SUGGESTIVE \u2014 phaser lag causes the ECU to compensate with positive trims. v1 ERR-CT-003 reactivated with TIMING_RETARDED evidence added",
      "chemistry_evidence": [
        {
          "state": "VVT_FAILURE",
          "tier": "GATING",
          "wiki_ref": "GAS_VOCABULARY \u00a73"
        },
        {
          "state": "TIMING_RETARDED",
          "tier": "SUGGESTIVE",
          "wiki_ref": "GAS_VOCABULARY \u00a73"
        }
      ],
      "obd_evidence": [
        {
          "pid": "stft_b1",
          "operator": "ge",
          "value": 2.0,
          "tier": "SUGGESTIVE",
          "units": "%",
          "wiki_ref": "OBD_VOCABULARY \u00a710.3"
        }
      ],
      "dtc_evidence": [
